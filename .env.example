# Copy to .env (git ignores .env) and fill in. Never paste these into chat or code.

# MongoDB Atlas: Atlas > your cluster > Connect > Drivers > Python. The string
# carries a database user's name and password.
MONGODB_URI=mongodb+srv://cyclopsdiary:<db-password>@cluster0.ixbz07.mongodb.net/?appName=Cluster0

MONGODB_DB=cyclopsdiary



# Offline instead of Atlas: a local mongod (scripts/mongo_local.sh), same code.
# MONGODB_URI=mongodb://localhost:27100

# The world model's read. The defaults are the setting the example-search
# numbers were measured at; change them and the footage pin changes with them.
# CYCLOPSDIARY_MODEL=nvidia/Cosmos3-Edge
# CYCLOPSDIARY_RATE=2.0          frames sampled per second
# CYCLOPSDIARY_FRAMES=2          frames per step (a 1-s step)
# CYCLOPSDIARY_FRAME_PX=196608   pixels per frame (384x512), source aspect kept
# CYCLOPSDIARY_WINDOW=8192       tokens of video the model keeps in its memory
# CYCLOPSDIARY_TOP_K=512         words kept per step
